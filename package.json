{
  "name": "goodday",
  "private": true,
  "description": "好日子 Good Days — 賣到全世界:跨境電商官網 + 會員系統 + 電商後台 + AI 自動報價",
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "build": "npm run build --workspace=web",
    "build:api": "npm run build --workspace=api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=web",
    "provision": "echo '⛔ provision 已停用：2026-10-08 三站資料庫合併後，執行會打壞正式站與小時光書店。原因見 scripts/provision.mjs 開頭' >&2 && exit 1"
  },
  "workspaces": [
    "web",
    "api"
  ],
  "engines": {
    "node": ">=20"
  }
}
